PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
# Optional SMTP settings for password recovery
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=FarmConnect <noreply@example.com>
CLIENT_URL=http://localhost:5173

# Razorpay TEST MODE only; obtain keys from your Razorpay dashboard
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Optional JSON array of dated, sourced reference prices; leave empty until you have genuine data.
# Example only (replace with a genuine source, actual location, date and price range before using):
# MARKET_PRICE_REFERENCE_JSON=[{"name":"Tomato","category":"Vegetables","unit":"kg","location":"Chennai","min":20,"max":35,"source":"Your verified market source","date":"2026-10-18"}]
MARKET_PRICE_REFERENCE_JSON=[]

# Demo-only: enables the login-page demo account picker. Set DEMO_MODE=true only in a local/demo environment.
DEMO_MODE=false
DEMO_ACCOUNT_PASSWORD=replace_with_a_demo_password

# Optional local FastAPI ML demonstration service (synthetic-data-only models)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=4000
